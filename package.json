  "username": "naandalist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Naandalist/react-native-device-spec-info.git"
  },
  "bugs": {
    "url": "https://github.com/Naandalist/react-native-device-spec-info/issues"
  },
  "homepage": "https://github.com/Naandalist/react-native-device-spec-info#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-device-info": ">=10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.79.5",
    "react-native-device-info": "14.1.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
